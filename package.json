{
  "name": "n8n-nodes-execution-tags",
  "version": "0.2.4",
  "description": "n8n community node to get, set, add and remove annotation tags of an execution via the n8n public API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "execution",
    "tags"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Kasp42/n8n-nodes-execution-tags",
  "author": {
    "name": "Kasp42",
    "email": "42@kasp.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kasp42/n8n-nodes-execution-tags.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ExecutionTagsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ExecutionTags/ExecutionTags.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.52.3",
    "eslint": "^9.39.5",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
